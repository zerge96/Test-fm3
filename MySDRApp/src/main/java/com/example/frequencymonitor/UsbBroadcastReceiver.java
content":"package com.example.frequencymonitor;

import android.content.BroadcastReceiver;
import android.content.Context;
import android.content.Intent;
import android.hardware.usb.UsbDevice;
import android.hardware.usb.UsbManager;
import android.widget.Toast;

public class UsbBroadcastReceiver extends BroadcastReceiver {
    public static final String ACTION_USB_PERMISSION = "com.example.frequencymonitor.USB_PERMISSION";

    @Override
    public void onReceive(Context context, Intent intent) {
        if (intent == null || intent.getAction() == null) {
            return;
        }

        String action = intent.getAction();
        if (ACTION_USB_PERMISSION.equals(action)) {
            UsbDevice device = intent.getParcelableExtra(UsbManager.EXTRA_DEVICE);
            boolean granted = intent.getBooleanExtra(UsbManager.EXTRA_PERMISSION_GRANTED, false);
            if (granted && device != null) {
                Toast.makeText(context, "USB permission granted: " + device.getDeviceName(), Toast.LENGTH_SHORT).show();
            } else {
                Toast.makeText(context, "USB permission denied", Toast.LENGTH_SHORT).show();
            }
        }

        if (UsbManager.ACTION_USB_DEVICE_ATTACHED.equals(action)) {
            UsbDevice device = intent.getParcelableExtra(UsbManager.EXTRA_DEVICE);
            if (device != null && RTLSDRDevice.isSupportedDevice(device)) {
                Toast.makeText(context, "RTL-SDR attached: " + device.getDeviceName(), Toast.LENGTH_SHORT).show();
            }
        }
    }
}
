package com.example.frequencymonitor;

import android.app.Activity;
import android.app.PendingIntent;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.SharedPreferences;
import android.content.pm.PackageManager;
import android.hardware.usb.UsbDevice;
import android.hardware.usb.UsbManager;
import android.media.AudioManager;
import android.media.ToneGenerator;
import android.os.Bundle;
import android.os.Handler;
import android.os.Looper;
import android.util.Log;
import android.widget.Button;
import android.widget.EditText;
import android.widget.ProgressBar;
import android.widget.TextView;
import android.widget.Toast;
import android.widget.ToggleButton;

import androidx.annotation.NonNull;
import androidx.core.app.ActivityCompat;
import androidx.core.content.ContextCompat;

import java.util.ArrayList;
import java.util.List;

public class MainActivity extends Activity {

    private static final String TAG = "Frequenzy_Monitor_V26";
    private static final int PERMISSION_REQUEST_CODE = 102;
    private static final String PREFS_NAME = "FrequencyMonitorPrefs";

    private static final long DEFAULT_START_FREQ = 380_000_000L;
    private static final long DEFAULT_STOP_FREQ = 385_000_000L;
    private static final float DEFAULT_ALARM_THRESHOLD = -50.0f;
    private static final int SCAN_STEP_KHZ = 100;
    private static final int SAMPLES_PER_FREQ = 10;
    private static final int SCAN_TIMEOUT_MS = 900;

    private TextView statusText;
    private TextView frequencyText;
    private TextView signalText;
    private TextView peakFrequencyText;
    private ProgressBar progressBar;
    private ProgressBar signalBar;

    private EditText startFreqEdit;
    private EditText stopFreqEdit;
    private EditText thresholdEdit;
    private EditText stepEdit;

    private Button scanButton;
    private Button stopButton;
    private Button saveButton;
    private ToggleButton muteButton;
    private ToggleButton alarmToggle;

    private boolean isScanning = false;
    private boolean isMuted = false;
    private boolean alarmEnabled = true;
    private long startFrequency = DEFAULT_START_FREQ;
    private long stopFrequency = DEFAULT_STOP_FREQ;
    private float alarmThreshold = DEFAULT_ALARM_THRESHOLD;
    private int scanStepKHz = SCAN_STEP_KHZ;

    private float peakSignal = -120.0f;
    private long peakFrequency = startFrequency;
    private final List<Float> signalHistory = new ArrayList<>();
    private static final int MAX_HISTORY = 50;

    private ToneGenerator toneGenerator;
    private Handler handler;
    private AudioManager audioManager;
    private int originalVolume;

    private SdrDeviceManager deviceManager;
    private SdrScanEngine scanEngine;
    private boolean isConnected = false;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        handler = new Handler(Looper.getMainLooper());
        audioManager = (AudioManager) getSystemService(Context.AUDIO_SERVICE);
        deviceManager = new SdrDeviceManager(getApplicationContext());

        initializeUI();
        loadPreferences();
        checkPermissions();
        initializeAudio();
        registerUsbReceiver();
        requestUsbPermissionForAttachedDevices();
        connectToUSB();
    }

    private void registerUsbReceiver() {
        IntentFilter filter = new IntentFilter();
        filter.addAction(UsbBroadcastReceiver.ACTION_USB_PERMISSION);
        filter.addAction(UsbManager.ACTION_USB_DEVICE_ATTACHED);
        registerReceiver(new UsbBroadcastReceiver(), filter);
    }

    private void initializeUI() {
        statusText = findViewById(R.id.statusText);
        frequencyText = findViewById(R.id.frequencyText);
        signalText = findViewById(R.id.signalText);
        peakFrequencyText = findViewById(R.id.peakFrequencyText);
        progressBar = findViewById(R.id.progressBar);
        signalBar = findViewById(R.id.signalBar);

        startFreqEdit = findViewById(R.id.startFreqEdit);
        stopFreqEdit = findViewById(R.id.stopFreqEdit);
        thresholdEdit = findViewById(R.id.thresholdEdit);
        stepEdit = findViewById(R.id.stepEdit);

        scanButton = findViewById(R.id.scanButton);
        stopButton = findViewById(R.id.stopButton);
        saveButton = findViewById(R.id.saveButton);
        muteButton = findViewById(R.id.muteButton);
        alarmToggle = findViewById(R.id.alarmToggle);

        scanButton.setOnClickListener(v -> startFrequencyScan());
        stopButton.setOnClickListener(v -> stopFrequencyScan());
        saveButton.setOnClickListener(v -> saveSettings());
        muteButton.setOnCheckedChangeListener((buttonView, isChecked) -> toggleMute(isChecked));
        alarmToggle.setOnCheckedChangeListener((buttonView, isChecked) -> alarmEnabled = isChecked);

        updateUIValues();
        updateUI();
    }

    private void loadPreferences() {
        SharedPreferences prefs = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
        startFrequency = prefs.getLong("startFreq", DEFAULT_START_FREQ);
        stopFrequency = prefs.getLong("stopFreq", DEFAULT_STOP_FREQ);
        alarmThreshold = prefs.getFloat("threshold", DEFAULT_ALARM_THRESHOLD);
        scanStepKHz = prefs.getInt("step", SCAN_STEP_KHZ);
    }

    private void updateUIValues() {
        startFreqEdit.setText(String.valueOf(startFrequency / 1_000_000));
        stopFreqEdit.setText(String.valueOf(stopFrequency / 1_000_000));
        thresholdEdit.setText(String.format("%.1f", alarmThreshold));
        stepEdit.setText(String.valueOf(scanStepKHz));
    }

    private void saveSettings() {
        try {
            startFrequency = Long.parseLong(startFreqEdit.getText().toString()) * 1_000_000;
            stopFrequency = Long.parseLong(stopFreqEdit.getText().toString()) * 1_000_000;
            alarmThreshold = Float.parseFloat(thresholdEdit.getText().toString());
            scanStepKHz = Integer.parseInt(stepEdit.getText().toString());

            SharedPreferences.Editor editor = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE).edit();
            editor.putLong("startFreq", startFrequency);
            editor.putLong("stopFreq", stopFrequency);
            editor.putFloat("threshold", alarmThreshold);
            editor.putInt("step", scanStepKHz);
            editor.apply();

            Toast.makeText(this, "✅ Settings saved", Toast.LENGTH_SHORT).show();
            updateFrequencyDisplay();
        } catch (NumberFormatException e) {
            Toast.makeText(this, "❌ Invalid input", Toast.LENGTH_SHORT).show();
        }
    }

    private void checkPermissions() {
        if (ContextCompat.checkSelfPermission(this, android.Manifest.permission.ACCESS_FINE_LOCATION)
                != PackageManager.PERMISSION_GRANTED) {
            ActivityCompat.requestPermissions(this,
                    new String[]{android.Manifest.permission.ACCESS_FINE_LOCATION},
                    PERMISSION_REQUEST_CODE);
        }
    }

    private void initializeAudio() {
        try {
            originalVolume = audioManager.getStreamVolume(AudioManager.STREAM_ALARM);
            toneGenerator = new ToneGenerator(AudioManager.STREAM_ALARM, 100);
        } catch (Exception e) {
            Log.e(TAG, "Audio initialization failed", e);
        }
    }

    private void requestUsbPermissionForAttachedDevices() {
        UsbManager usbManager = (UsbManager) getSystemService(Context.USB_SERVICE);
        if (usbManager == null) {
            return;
        }

        for (UsbDevice device : usbManager.getDeviceList().values()) {
            if (!RTLSDRDevice.isSupportedDevice(device) || usbManager.hasPermission(device)) {
                continue;
            }

            PendingIntent permissionIntent = PendingIntent.getBroadcast(
                    this,
                    0,
                    new Intent(UsbBroadcastReceiver.ACTION_USB_PERMISSION),
                    PendingIntent.FLAG_MUTABLE | PendingIntent.FLAG_UPDATE_CURRENT
            );
            usbManager.requestPermission(device, permissionIntent);
        }
    }

    private void connectToUSB() {
        new Thread(() -> {
            try {
                List<RTLSDRDevice> discoveredDevices = deviceManager.discoverSupportedDevices();
                isConnected = !discoveredDevices.isEmpty();

                if (!isConnected) {
                    runOnUiThread(() -> {
                        statusText.setText("❌ No supported RTL-SDR USB dongle detected\nConnect a supported device and allow USB access.");
                        updateUI();
                    });
                    return;
                }

                if (deviceManager.isSingleDongleMode()) {
                    runOnUiThread(() -> {
                        statusText.setText("✅ 1 RTL-SDR connected\nSingle-dongle mode active\nNative SDR backend required for live scans.");
                        updateUI();
                    });
                } else {
                    runOnUiThread(() -> {
                        statusText.setText("✅ 2 RTL-SDR devices connected\nDual-dongle mode prepared\nNative SDR backend required for live scans.");
                        updateUI();
                    });
                }
            } catch (Exception e) {
                Log.e(TAG, "USB connection error", e);
                runOnUiThread(() -> statusText.setText("❌ USB connection error"));
            }
        }).start();
    }

    private void startFrequencyScan() {
        if (!isConnected || deviceManager.getConnectedCount() == 0) {
            Toast.makeText(this, "❌ SDR not connected", Toast.LENGTH_SHORT).show();
            return;
        }

        if (!deviceManager.hasNativeBackend()) {
            statusText.setText("❌ Native RTL-SDR backend not connected yet\nThis app is ready for hardware integration, but the live SDR driver is still required.");
            return;
        }

        isScanning = true;
        peakSignal = -120.0f;
        peakFrequency = startFrequency;
        signalHistory.clear();
        updateUI();
        statusText.setText("🔍 Scanning...");
        progressBar.setProgress(0);

        ScanConfig config = new ScanConfig(startFrequency, stopFrequency, alarmThreshold, scanStepKHz, SAMPLES_PER_FREQ);
        scanEngine = new SdrScanEngine(deviceManager.getConnectedDevices(), new SdrScanEngine.Listener() {
            @Override
            public void onProgress(int progressPercent, float currentDbm) {
                runOnUiThread(() -> {
                    progressBar.setProgress(progressPercent);
                    signalText.setText(String.format("Current: %.1f dBm", currentDbm));
                    updateSignalBar(currentDbm);
                });
            }

            @Override
            public void onComplete(ScanResult result) {
                runOnUiThread(() -> {
                    peakSignal = result.peakDbm;
                    peakFrequency = result.peakFrequencyHz;
                    statusText.setText(String.format("📊 Scan Complete\nPeak: %.1f dBm @ %.2f MHz\nRange: %.0f - %.0f MHz",
                            result.peakDbm,
                            result.peakFrequencyHz / 1_000_000.0,
                            startFrequency / 1_000_000.0,
                            stopFrequency / 1_000_000.0));
                    peakFrequencyText.setText(String.format("Peak: %.2f MHz | %.1f dBm",
                            result.peakFrequencyHz / 1_000_000.0, result.peakDbm));
                    progressBar.setProgress(100);
                    isScanning = false;
                    updateUI();
                });
            }

            @Override
            public void onError(String message) {
                runOnUiThread(() -> {
                    statusText.setText("❌ " + message);
                    isScanning = false;
                    updateUI();
                });
            }
        });
        scanEngine.start(config);
    }

    private void stopFrequencyScan() {
        isScanning = false;
        if (scanEngine != null) {
            scanEngine.stop();
        }
        statusText.setText("⏹️ Scan stopped");
        updateUI();
    }

    private void playAlarm() {
        if (isMuted || toneGenerator == null) return;
        try {
            toneGenerator.startTone(ToneGenerator.TONE_CDMA_ALERT_CALL_GUARD, 200);
        } catch (Exception e) {
            Log.e(TAG, "Alarm error", e);
        }
    }

    private void toggleMute(boolean muted) {
        isMuted = muted;
        if (muted) {
            originalVolume = audioManager.getStreamVolume(AudioManager.STREAM_ALARM);
            audioManager.setStreamVolume(AudioManager.STREAM_ALARM, 0, 0);
            muteButton.setText("🔇 Muted");
        } else {
            audioManager.setStreamVolume(AudioManager.STREAM_ALARM, originalVolume, 0);
            muteButton.setText("🔊 Unmute");
        }
    }

    private void updateFrequencyDisplay() {
        frequencyText.setText(String.format(
                "📡 Range: %.0f - %.0f MHz\nThreshold: %.1f dBm",
                startFrequency / 1_000_000.0,
                stopFrequency / 1_000_000.0,
                alarmThreshold
        ));
    }

    private void updateSignalBar(float signal) {
        int barValue = (int) ((signal + 100) * 2.55);
        signalBar.setProgress(Math.max(0, Math.min(255, barValue)));
    }

    private void updateUI() {
        startFreqEdit.setEnabled(!isScanning);
        stopFreqEdit.setEnabled(!isScanning);
        thresholdEdit.setEnabled(!isScanning);
        stepEdit.setEnabled(!isScanning);
        saveButton.setEnabled(!isScanning);
        scanButton.setEnabled(!isScanning && isConnected && deviceManager.hasNativeBackend());
        stopButton.setEnabled(isScanning);
        updateFrequencyDisplay();
    }

    @Override
    protected void onDestroy() {
        super.onDestroy();
        isScanning = false;
        deviceManager.release();
        if (scanEngine != null) {
            scanEngine.stop();
        }
        if (toneGenerator != null) {
            toneGenerator.release();
        }
    }

    @Override
    public void onRequestPermissionsResult(int requestCode, @NonNull String[] permissions,
                                          @NonNull int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        if (requestCode == PERMISSION_REQUEST_CODE) {
            connectToUSB();
        }
    }
}
